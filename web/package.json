    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.33.0",
    "marked": "^18.1.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
