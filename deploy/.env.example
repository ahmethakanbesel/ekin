# Copy to deploy/.env (never commit it).

# The address people open in the browser; https makes the session cookie Secure.
KURGU_PUBLIC_URL=https://kurgu.example.com
KURGU_LOG_LEVEL=info
KURGU_SCHEDULER_TICK=30s

# Worker throttling (PLAN.md §4). List only the queues this host serves.
KURGU_QUEUE_CONCURRENCY=control=1,agent=1,tts=1,render=1,extract=1,io=2
KURGU_HEAVY_EXCLUSIVE=true
# Queues that heavy exclusivity covers; "none" for no queue.
KURGU_HEAVY_QUEUES=agent,tts,render
KURGU_HEAVY_COOLDOWN=30s
KURGU_WORKER_PAUSED=false
# Percent of the host's CPUs the job processes (Claude Code, Chrome, ffmpeg,
# speech) may use together; 0 = no limit. Linux only. The host profile saved
# in the UI overrides it, live.
KURGU_CPU_LIMIT=0
# Scheduling priority of the job processes, 0 (normal) to 19 (lowest); Linux and
# macOS. The Kurgu server keeps its own priority.
KURGU_NICE=0

# Litestream replica (S3-compatible).
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Authoring agent: `claude setup-token` on any machine, paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# KURGU_CLAUDE_MODEL=

# Stock footage (optional): https://www.pexels.com/api/
KURGU_PEXELS_API_KEY=

# ElevenLabs narration (optional, paid per character): https://elevenlabs.io/app/settings/api-keys
KURGU_ELEVENLABS_API_KEY=

# Email digests (optional).
KURGU_SMTP_HOST=
KURGU_SMTP_PORT=587
KURGU_SMTP_USERNAME=
KURGU_SMTP_PASSWORD=
KURGU_SMTP_FROM=Kurgu <kurgu@example.com>

# Duplicate-idea verdicts with Jev (optional).
KURGU_OPENROUTER_API_KEY=

# YouTube publishing: a Google Cloud OAuth client (web application) with the
# redirect URI <KURGU_PUBLIC_URL>/api/v1/oauth/youtube/callback.
KURGU_YOUTUBE_CLIENT_ID=
KURGU_YOUTUBE_CLIENT_SECRET=

# Hybrid worker: set a long random token here, and on the Mac run
#   KURGU_REMOTE_URL=https://kurgu.example.com KURGU_WORKER_TOKEN=<same> kurgu worker
# then set this host's agent/render concurrency to 0 in the host profile.
KURGU_WORKER_TOKEN=
