# Copy to deploy/.env (never commit it).

# Image tag to run (a release such as 1.2.0); latest when unset.
# EKIN_VERSION=latest

# The address people open in the browser; https makes the session cookie Secure.
EKIN_PUBLIC_URL=https://ekin.example.com
EKIN_LOG_LEVEL=info
EKIN_SCHEDULER_TICK=30s

# Worker throttling (PLAN.md §4). List only the queues this host serves.
EKIN_QUEUE_CONCURRENCY=control=1,agent=1,tts=1,render=1,extract=1,io=2
EKIN_HEAVY_EXCLUSIVE=true
# Queues that heavy exclusivity covers; "none" for no queue.
EKIN_HEAVY_QUEUES=agent,tts,render
EKIN_HEAVY_COOLDOWN=30s
EKIN_WORKER_PAUSED=false
# Percent of the host's CPUs the job processes (Claude Code, Chrome, ffmpeg,
# speech) may use together; 0 = no limit. Linux only. The host profile saved
# in the UI overrides it, live.
EKIN_CPU_LIMIT=0
# Scheduling priority of the job processes, 0 (normal) to 19 (lowest); Linux and
# macOS. The Ekin server keeps its own priority.
EKIN_NICE=0

# Litestream replica (S3-compatible).
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Authoring agent: `claude setup-token` on any machine, paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# EKIN_CLAUDE_MODEL=
# EKIN_CLAUDE_EFFORT=     # low, medium, high, xhigh or max

# Stock footage (optional): https://www.pexels.com/api/
EKIN_PEXELS_API_KEY=

# ElevenLabs narration (optional, paid per character): https://elevenlabs.io/app/settings/api-keys
EKIN_ELEVENLABS_API_KEY=

# Shorts cut from long videos (docs/shorts.md); the defaults are shown.
# EKIN_SHORTS_SOURCE_MIN=4m      # long videos shorter than this are not cut
# EKIN_SHORTS_SOURCE_MAX=60m     # nor longer than this
# EKIN_SHORTS_CLIP_MIN=20s       # shortest short (at least 10s)
# EKIN_SHORTS_CLIP_MAX=60s       # longest short (at most 3m)
# EKIN_SHORTS_MAX_PER_VIDEO=5    # shorts per long video, 0 to 20
# EKIN_SHORTS_MIN_GAP=30s        # least time between two shorts of one video

# Email digests (optional).
EKIN_SMTP_HOST=
EKIN_SMTP_PORT=587
EKIN_SMTP_USERNAME=
EKIN_SMTP_PASSWORD=
EKIN_SMTP_FROM=Ekin <ekin@example.com>

# Duplicate-idea verdicts with Jev (optional).
EKIN_OPENROUTER_API_KEY=

# YouTube publishing: a Google Cloud OAuth client (web application) with the
# redirect URI <EKIN_PUBLIC_URL>/api/v1/oauth/youtube/callback.
EKIN_YOUTUBE_CLIENT_ID=
EKIN_YOUTUBE_CLIENT_SECRET=

# Hybrid worker: set a long random token here, and on the Mac run
#   EKIN_REMOTE_URL=https://ekin.example.com EKIN_WORKER_TOKEN=<same> ekin worker
# then set this host's agent/render concurrency to 0 in the host profile.
EKIN_WORKER_TOKEN=
