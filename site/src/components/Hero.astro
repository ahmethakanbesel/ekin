---
import { accessUrl } from "../site"

// An illustrative season: one long video a week, the shorts cut from it,
// and the article beside it. Past weeks are out, this week waits for
// review, next week is being drafted.
interface Week {
  label: string
  status: "published" | "review" | "drafting"
  poster: string
  title: string
  shorts: number
}

const weeks: Week[] = [
  { label: "Week 1", status: "published", poster: "var(--poster-1)", title: "Why sleep resets the mood", shorts: 2 },
  { label: "Week 2", status: "published", poster: "var(--poster-2)", title: "Worry versus anxiety", shorts: 3 },
  { label: "Week 3", status: "published", poster: "var(--poster-4)", title: "The two-minute rule", shorts: 3 },
  { label: "Week 4", status: "review", poster: "var(--poster-3)", title: "What a panic attack is", shorts: 0 },
  { label: "Week 5", status: "drafting", poster: "var(--poster-5)", title: "Habits that outlast January", shorts: 0 },
]

const statusText = { published: "Published", review: "In review", drafting: "Drafting" }
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="copy">
    <p class="eyebrow">Content-led growth</p>
    <h1 id="hero-title">Content that keeps growing.</h1>
    <p class="lede">
      Ekin turns your ideas, documents and search opportunities into YouTube videos, Shorts and
      articles on a schedule. Every piece waits for your review before it goes out.
    </p>
    <div class="actions">
      <a class="button button-primary" href={accessUrl}>Get early access</a>
      <a class="button button-quiet" href="#how">See how it works</a>
    </div>
  </div>

  <figure class="season" aria-label="An example season: one video a week, its Shorts and its article">
    <div class="season-head">
      <span>Health & Mind · weekly</span>
      <span class="muted">Tuesdays, 09:00</span>
    </div>
    <ol class="weeks">
      {
        weeks.map((w) => (
          <li class:list={["week", w.status]}>
            <span class="week-label">{w.label}</span>
            <span class="poster" style={`--hue: ${w.poster}`}>
              <span class="poster-title">{w.title}</span>
              <span class="poster-time">8:12</span>
            </span>
            <span class="shorts" aria-label={`${w.shorts} Shorts`}>
              {Array.from({ length: 4 }, (_, i) => (
                <span class:list={["short", { on: i < w.shorts }]} style={`--hue: ${w.poster}`} />
              ))}
            </span>
            <span class="sheet" aria-hidden="true">
              <span />
              <span />
              <span />
            </span>
            <span class:list={["status", w.status]}>{statusText[w.status]}</span>
          </li>
        ))
      }
    </ol>
    <figcaption class="muted">Illustration: one video a week, its Shorts and its article.</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    gap: 48px;
    padding-block: 56px 72px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero {
      grid-template-columns: 1fr 1.05fr;
      padding-block: 88px 112px;
    }
  }
  .copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .muted {
    color: var(--stone-text);
  }

  .season {
    margin: 0;
    padding: 18px;
    border-radius: 18px;
    background: var(--card);
    box-shadow: var(--shadow), inset 0 0 0 1px var(--hairline);
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .season-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.8125rem;
    font-weight: 550;
  }
  .season figcaption {
    font-size: 0.75rem;
  }
  .weeks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }
  .week {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
  }
  .week-label {
    font-size: 0.6875rem;
    color: var(--stone-text);
    font-variant-numeric: tabular-nums;
  }
  .poster {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    background:
      radial-gradient(120% 90% at 20% 10%, oklch(1 0 0 / 22%), transparent 60%),
      var(--hue);
    color: oklch(1 0 0);
    padding: 6px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .poster-title {
    font-size: 0.625rem;
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .poster-time {
    position: absolute;
    top: 5px;
    right: 5px;
    font-size: 0.5625rem;
    font-family: var(--font-mono);
    background: oklch(0 0 0 / 45%);
    border-radius: 4px;
    padding: 0 3px;
  }
  .shorts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
  }
  .short {
    aspect-ratio: 9 / 16;
    border-radius: 4px;
    background: var(--stone-fill);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .short.on {
    background: color-mix(in oklch, var(--hue) 80%, var(--card));
    box-shadow: none;
  }
  .sheet {
    display: grid;
    gap: 4px;
    padding: 7px 6px;
    border-radius: 6px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--paper-edge);
  }
  .sheet span {
    height: 3px;
    border-radius: 2px;
    background: color-mix(in oklch, var(--paper-ink) 25%, var(--paper));
  }
  .sheet span:nth-child(2) {
    width: 85%;
  }
  .sheet span:nth-child(3) {
    width: 60%;
  }
  .status {
    justify-self: start;
    font-size: 0.625rem;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status.published {
    color: var(--ready);
    background: color-mix(in oklch, var(--ready) 15%, transparent);
  }
  .status.review {
    color: var(--cornflower-ink);
    background: color-mix(in oklch, var(--cornflower) 22%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--cornflower-ink) 40%, transparent);
  }
  .status.drafting {
    color: var(--working);
    background: color-mix(in oklch, var(--working) 15%, transparent);
  }
  .week.drafting .poster {
    background: repeating-linear-gradient(
      -45deg,
      var(--stone-fill) 0 6px,
      color-mix(in oklch, var(--stone-fill) 60%, var(--card)) 6px 12px
    );
    color: var(--stone-text);
  }
  .week.drafting .poster-time {
    display: none;
  }
  .week.drafting .sheet {
    opacity: 0.45;
  }
  @media (max-width: 520px) {
    .weeks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .week:nth-child(-n + 2) {
      display: none;
    }
  }
</style>
